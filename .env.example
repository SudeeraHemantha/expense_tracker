# Environment Variables Configuration for Expense Tracker API & Dashboard

APP_NAME="Expense Tracker API"
APP_ENV="development"
DEBUG=true

# Database Connection URL
DB_PATH="sqlite:///./data/expenses.db"

# Default Currency Code
DEFAULT_CURRENCY="LKR"

# CORS Origins (Comma separated string or JSON array)
CORS_ORIGINS=["*"]

# Budget Alert Threshold Percentage (Default 80%)
ALERT_THRESHOLD_PERCENTAGE=80.0

# Security & JWT Tokens
SECRET_KEY="your_secure_jwt_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM API Keys for AI Natural Language & Vision Receipt Ingestion
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
